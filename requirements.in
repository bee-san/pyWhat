# The development tools (the package's own dependencies are in pyproject.toml).
# requirements.txt pins them and everything they need, for every Python version from 3.8
# (the newest release that supports each version):
#
#   uv pip compile --universal --python-version 3.8 requirements.in -o requirements.txt
#
# The test session in noxfile.py installs requirements.txt, then the package itself.

# The versions of the package's own dependencies that the tests run with
click==8.1.2
rich==12.2.0

# pytest and the plugins that pyproject.toml turns on. pytest-black 0.6.0, its last
# release, doesn't load on pytest 9 (its hook takes the `path` argument that pytest 9
# removed).
pytest<9
pytest-black
pytest-cov
pytest-flake8
pytest-isort
pytest-mypy
# The newest versions that accept the code as it is: black 24 would reformat 23 files, and
# isort 6 and mypy 1.15 need Python 3.9
black==23.12.1
isort==5.13.2
mypy==1.14.1
types-orjson
types-requests

# The upload of the coverage (the "coverage" session, on CI)
codecov

# scripts/get_file_sigs.py and scripts/get_tlds.py
requests
